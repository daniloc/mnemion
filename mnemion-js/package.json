{
  "name": "mnemion",
  "version": "0.6.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build:pages": "vite build --config vite.fragment.ts",
    "build:web": "vite build --config vite.web.ts",
    "preview:render": "vite dev --config vite.preview.ts --open /render-preview.html",
    "dev": "concurrently -k -n worker,app -c blue,green \"npm:dev:worker\" \"npm:dev:app\"",
    "dev:worker": "wrangler dev --var DEV:true --var DEV_SEED:true --var SKIP_EMBED:1 --port 4281",
    "dev:app": "vite dev --config vite.web.ts",
    "dev:built": "npm run build:pages && npm run build:web && wrangler dev --var DEV:true --var DEV_SEED:true",
    "deploy": "npm run build:pages && npm run build:web && wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/pages/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp:smoke": "node scripts/mcp-smoke.mjs",
    "setup": "bash scripts/setup.sh",
    "enable-documents": "bash scripts/enable-documents.sh",
    "cruft": "npx --yes ts-prune -p tsconfig.json | grep -v 'used in module'",
    "coherence:spec": "coherence spec --check",
    "coherence:run": "coherence run",
    "coherence:hooks-check": "node scripts/coherence-hooks.mjs check",
    "coherence:hooks-install": "node scripts/coherence-hooks.mjs install",
    "coherence:scope": "coherence scope"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.10.4",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/ext-apps": "^1.7.4",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-select": "^2.1.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "@simplewebauthn/server": "^13.3.1",
    "agents": "^0.28.0",
    "fflate": "^0.8.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-is": "^19.2.7",
    "recharts": "^3.8.1",
    "unpdf": "^1.6.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@cloudflare/workers-types": "^4.20260615.1",
    "@posthog/coherence": "https://github.com/PostHog/coherence/releases/download/v1.11.0-beta.2/posthog-coherence-1.11.0-beta.2.tgz",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "ai": "^6.0.315",
    "concurrently": "^9.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.12",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "undici": "^7.30.1",
    "zod": "$zod"
  }
}
