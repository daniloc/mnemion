{
  "name": "Mnemion for Apple platforms",
  "language": "swift",
  "plugins": { "swift": "./coherence-plugins/swift" },
  "references": "project",
  "ignore": [".build", "DerivedData", "Mnemion.xcodeproj", "coherence-plugins"],
  "test": "cd MnemionKit && swift test --scratch-path /tmp/mnemionkit-build --filter {filter}",
  "testMatch": "Test run with [1-9][0-9]* tests? in [0-9]+ suites? passed"
}
